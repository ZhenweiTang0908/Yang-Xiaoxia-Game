func _init():reset();load_settings()
func reset():
 values.clear()
 for key in SCHEMA:values[key]=float(SCHEMA[key][1])
func get_value(key):return float(values.get(key,SCHEMA[key][1]))
func apply(data):
 for key in SCHEMA:
  var value=data.get(key,values[key])
  if (value is float or value is int) and is_finite(float(value)):
   values[key]=clampf(float(value),SCHEMA[key][2],SCHEMA[key][3])
 values.moon_gap=maxf(values.moon_gap,maxf(values.moon_warning*.5+.01,values.moon_core+.02))
 values.moon_cycle=maxf(values.moon_cycle,2*values.moon_gap+values.moon_warning+values.moon_core+values.moon_afterglow+.1)
 values.critical_threshold=minf(values.critical_threshold,values.proc_threshold)
 values.heal_duration=minf(values.heal_duration,values.carry_duration)
 # A full jump keeps the feet above the spear wave for about 0.92 s, so the late
 # third wave must stay at least 0.95 s later than the even rhythm.
 values.knight_wave_late=maxf(values.knight_wave_late,values.knight_wave_gap+.95)
 values.lion_finale_fraction=minf(values.lion_finale_fraction,values.lion_phase_fraction)
 for index in range(1,21):
  var prefix="lion_M%02d_"%index
  values[prefix+"range_max"]=maxf(values[prefix+"range_min"],values[prefix+"range_max"])
  var beat=0
  var previous=-1.0
  while values.has(prefix+str(beat)+"_time"):
   var part=prefix+str(beat)+"_"
   values[part+"time"]=maxf(previous+.40,values[part+"time"])
   values[part+"far"]=maxf(values[part+"near"]+1,values[part+"far"])
   values[part+"high"]=maxf(values[part+"low"]+1,values[part+"high"])
   previous=values[part+"time"];beat+=1
func load_settings(path=PATH):
 if FileAccess.file_exists(path):
  var parsed=JSON.parse_string(FileAccess.get_file_as_string(path))
  if parsed is Dictionary:
   if not parsed.has("summon_stamina_revision"):
    if parsed.get("ally_hp",50.0)==50.0:parsed.ally_hp=200.0
    if parsed.get("summon_cooldown",25.0)==25.0:parsed.summon_cooldown=20.0
   apply(parsed)
func save_settings(path=PATH):
 var file=FileAccess.open(path,FileAccess.WRITE)
 if file:
  var saved=values.duplicate();saved.summon_stamina_revision=1
  file.store_string(JSON.stringify(saved));return true
 return false
func probability(health):
 if health<get_value("critical_threshold"):return get_value("critical_chance")/100.0
 if health<get_value("proc_threshold"):return get_value("proc_chance")/100.0
 return 0.0
