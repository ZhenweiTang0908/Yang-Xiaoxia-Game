    "lion": {
      "title": "衔灯狮叟",
      "voice": "Orus",
      "lines": {
        "intro": "哎哟，今夜可算有观众啦。",
        "intro_b": "小客官，借你一双眼，看场热闹！",
        "bow": "先揖个礼，再论高低。",
        "bow_b": "站稳喽，老狮子要醒啦。",
        "phase_2": "狮子累了，换我陪你耍耍。",
        "phase_2_b": "这回看清了，里头就我一个！",
        "low": "腰是老了，脚可没老。",
        "low_b": "剩下这点本事，都给你瞧！",
        "defeat": "好，好！这盏灯，跟你走。",
        "defeat_b": "老头子服啦，前头的路可别走暗了。",
        "player_heavy": "疼吧？逞能这毛病，我也有。",
        "player_heavy_b": "哎呀，收着点下巴呀。",
        "player_recover": "喝你的，老头子也歇口气。",
        "player_recover_b": "这口喝完，咱们再热闹。",
        "player_death": "先歇着，灯给你留着呢。",
        "player_death_b": "别急，明儿还开场。",
        "pounce": "看好这张大嘴！",
        "pounce_b": "老狮子也想亲近人呐。",
        "wash_foot": "借个地方，抖抖鞋。",
        "wash_foot_b": "哎，脚底这点事儿。",
        "lion_slam": "再给你抬高些！",
        "lion_slam_b": "这一下，可要看仔细。",
        "lion_roll": "借条路，借条路！",
        "lion_roll_b": "哎哟，圆的就是跑得快。",
        "back_kick": "后头那位，也有份儿。",
        "back_kick_b": "别光看我这张脸呀。",
        "high_sweep": "抬头看，多精神！",
        "high_sweep_b": "老狮子还长得高呢。",
        "lion_sleep": "眯一会儿，就一会儿。",
        "lion_sleep_b": "别走啊，我没睡着。",
        "lion_steps": "这腿脚，还上得了场。",
        "lion_steps_b": "一步一步，热闹起来！",
        "cup_elbow": "小客官，敬你一下。",
        "cup_elbow_b": "手抬起来，礼数不能少。",
        "lean_kick": "腰借我使使。",
        "lean_kick_b": "站不稳，也有站不稳的妙处。",
        "sit_kick": "地上也挺舒服。",
        "sit_kick_b": "矮一点，倒看得清楚。",
        "ground_roll": "躺着也能陪你聊。",
        "ground_roll_b": "这边翻完，还有那边。",
        "handstand": "天地倒过来，照样瞧你。",
        "handstand_b": "老头子还没倒呢！",
        "turn_kick": "来来来，再近些。",
        "turn_kick_b": "别送了，别送了——哎！",
        "toss_palm": "接好了……我说我自己。",
        "toss_palm_b": "壶要紧，客人也得招呼。",
        "shuffle": "挪个座，咱俩都宽敞。",
        "shuffle_b": "借半张凳子的地方。",
        "double_palm": "袖子上这点灰呀。",
        "double_palm_b": "拍两下，精神精神。",
        "twist": "咦，这脚怎么不听话？",
        "twist_b": "错一步，也能走回来。",
        "lion_finale": "这场狮舞，给你收个好尾。",
        "lion_finale_b": "还没散场呢，小客官。",
        "drunk_finale": "最后这礼，可得接稳。",
        "drunk_finale_b": "陪老头子，再热闹一回！",
        "counter_head": "哎哟，谁把门给关啦？",
        "counter_head_b": "好小子，连狮子也敢逗！",
        "counter_gourd": "哎哎哎，我的壶！",
        "counter_gourd_b": "这手准的，专挑我忙的时候。",
        "counter_support": "懂行啊，瞧的是脚下。",
        "counter_support_b": "行，这一下算你眼尖！",
        "perfect_dodge": "嘿，倒叫你钻过去啦。",
        "perfect_dodge_b": "漂亮！再来，别让着我。",
        "ally_enter": "哟，还带了位捧场的。",
        "ally_enter_b": "两位客官，那可更热闹！",
        "rest": "一口，就润润嗓子。",
        "rest_b": "别催呀，老腰也得喘口气。"
      },
